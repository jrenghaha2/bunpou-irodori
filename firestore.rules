rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Security Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Bootstrapped first Superadmin (requires verified Auth email token)
    function isBootstrapSuperAdmin() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'jrenghaha2@gmail.com';
    }

    function hasCallerProfile() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerRole() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return ('role' in profile && profile.role is string) ? profile.role : 'user';
    }

    function isSuperAdmin() {
      return isBootstrapSuperAdmin()
        || (hasCallerProfile() && callerRole() == 'superadmin');
    }

    function isAdminOrSuperAdmin() {
      return isBootstrapSuperAdmin()
        || (hasCallerProfile() && callerRole() in ['admin', 'superadmin']);
    }

    function isValidBookId(bookId) {
      return bookId is string && bookId in ['introductory', 'elementary1', 'elementary2'];
    }

    function isValidDisplayName(data) {
      return !('displayName' in data)
        || (data.displayName is string && data.displayName.size() <= 60);
    }

    function isValidAvatarUrl(data) {
      return !('avatarUrl' in data)
        || (data.avatarUrl is string
          && data.avatarUrl.size() <= 20000
          && (data.avatarUrl.size() == 0
            || data.avatarUrl.matches('^https://[^\\s]+$')
            || data.avatarUrl.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')));
    }

    function isValidOptionalEmail(data) {
      return !('email' in data)
        || (data.email is string && data.email.size() <= 120);
    }

    function isCallerBoundEmail(data) {
      return !('email' in data)
        || data.email == ''
        || (request.auth.token.email is string
          && data.email == request.auth.token.email.lower());
    }

    function isValidOptionalRole(data) {
      return !('role' in data)
        || (data.role is string && data.role in ['user', 'admin', 'superadmin']);
    }

    // Full-array validation without loops using dual-separator join (',' and '|'):
    // Enforces list type, max size (<= 150), uniqueness (toSet), and exact per-book Bunpou pattern ID format.
    function isValidIntroductoryList(arr) {
      return arr is list
        && arr.size() <= 150
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            arr[0] is string
            && arr[0].matches('^introductory-bab-([1-9]|1[0-8])-p[1-9][0-9]?$')
            && arr.join(',').size() <= 4000
            && arr.join(',').matches('^introductory-bab-([1-9]|1[0-8])-p[1-9][0-9]?(,introductory-bab-([1-9]|1[0-8])-p[1-9][0-9]?)*$')
            && arr.join('|').matches('^introductory-bab-([1-9]|1[0-8])-p[1-9][0-9]?(\\|introductory-bab-([1-9]|1[0-8])-p[1-9][0-9]?)*$')
          )
        );
    }

    function isValidElementary1List(arr) {
      return arr is list
        && arr.size() <= 150
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            arr[0] is string
            && arr[0].matches('^elementary1-bab-([1-9]|1[0-8])-p[1-9][0-9]?$')
            && arr.join(',').size() <= 4000
            && arr.join(',').matches('^elementary1-bab-([1-9]|1[0-8])-p[1-9][0-9]?(,elementary1-bab-([1-9]|1[0-8])-p[1-9][0-9]?)*$')
            && arr.join('|').matches('^elementary1-bab-([1-9]|1[0-8])-p[1-9][0-9]?(\\|elementary1-bab-([1-9]|1[0-8])-p[1-9][0-9]?)*$')
          )
        );
    }

    function isValidElementary2List(arr) {
      return arr is list
        && arr.size() <= 150
        && arr.toSet().size() == arr.size()
        && (
          arr.size() == 0
          || (
            arr[0] is string
            && arr[0].matches('^elementary2-bab-([1-9]|1[0-8])-p[1-9][0-9]?$')
            && arr.join(',').size() <= 4000
            && arr.join(',').matches('^elementary2-bab-([1-9]|1[0-8])-p[1-9][0-9]?(,elementary2-bab-([1-9]|1[0-8])-p[1-9][0-9]?)*$')
            && arr.join('|').matches('^elementary2-bab-([1-9]|1[0-8])-p[1-9][0-9]?(\\|elementary2-bab-([1-9]|1[0-8])-p[1-9][0-9]?)*$')
          )
        );
    }

    function isValidBunpouList(arr, bookId) {
      return (bookId == 'introductory' && isValidIntroductoryList(arr))
        || (bookId == 'elementary1' && isValidElementary1List(arr))
        || (bookId == 'elementary2' && isValidElementary2List(arr));
    }

    // Compact pure-ASCII quiz session token validation (per-book patternId prefix enforced):
    // Format: id|completedAt|focus|correct|total|score|scopeCode|answersPacked
    // answersPacked items separated by ';': no:typeCode:patternId:isCorrectBit(:chosenB64Url)?
    // typeCode: 0=cloze, 1=formula, 2=function; isCorrectBit: 1=right, 0=wrong; optional 5th Base64URL segment (<= 260 ASCII chars)
    function isValidIntroductoryQuizToken(val) {
      return val is string
        && val.size() >= 24
        && val.size() <= 16000
        && val.matches('^[a-zA-Z0-9_\\-]+\\|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z\\|(mixed|cloze|formula|function)\\|[0-9]{1,3}\\|[1-9][0-9]{0,2}\\|(100|[0-9]{1,2})\\|(all|([1-9]|1[0-8])(\\.([1-9]|1[0-8]))*)\\|(|[1-9][0-9]{0,2}:[0-2]:introductory-bab-([1-9]|1[0-8])-p[1-9][0-9]?:[01](:[A-Za-z0-9_\\-]{1,260})?(;[1-9][0-9]{0,2}:[0-2]:introductory-bab-([1-9]|1[0-8])-p[1-9][0-9]?:[01](:[A-Za-z0-9_\\-]{1,260})?)*)$');
    }

    function isValidElementary1QuizToken(val) {
      return val is string
        && val.size() >= 24
        && val.size() <= 16000
        && val.matches('^[a-zA-Z0-9_\\-]+\\|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z\\|(mixed|cloze|formula|function)\\|[0-9]{1,3}\\|[1-9][0-9]{0,2}\\|(100|[0-9]{1,2})\\|(all|([1-9]|1[0-8])(\\.([1-9]|1[0-8]))*)\\|(|[1-9][0-9]{0,2}:[0-2]:elementary1-bab-([1-9]|1[0-8])-p[1-9][0-9]?:[01](:[A-Za-z0-9_\\-]{1,260})?(;[1-9][0-9]{0,2}:[0-2]:elementary1-bab-([1-9]|1[0-8])-p[1-9][0-9]?:[01](:[A-Za-z0-9_\\-]{1,260})?)*)$');
    }

    function isValidElementary2QuizToken(val) {
      return val is string
        && val.size() >= 24
        && val.size() <= 16000
        && val.matches('^[a-zA-Z0-9_\\-]+\\|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z\\|(mixed|cloze|formula|function)\\|[0-9]{1,3}\\|[1-9][0-9]{0,2}\\|(100|[0-9]{1,2})\\|(all|([1-9]|1[0-8])(\\.([1-9]|1[0-8]))*)\\|(|[1-9][0-9]{0,2}:[0-2]:elementary2-bab-([1-9]|1[0-8])-p[1-9][0-9]?:[01](:[A-Za-z0-9_\\-]{1,260})?(;[1-9][0-9]{0,2}:[0-2]:elementary2-bab-([1-9]|1[0-8])-p[1-9][0-9]?:[01](:[A-Za-z0-9_\\-]{1,260})?)*)$');
    }

    function isValidQuizSessionToken(val, bookId) {
      return (bookId == 'introductory' && isValidIntroductoryQuizToken(val))
        || (bookId == 'elementary1' && isValidElementary1QuizToken(val))
        || (bookId == 'elementary2' && isValidElementary2QuizToken(val));
    }

    // Element-wise bounded validation across all 15 slots avoids running giant regexes over a 120 KB joined string
    function isValidQuizHistorySessions(arr, bookId) {
      return arr is list
        && arr.size() <= 15
        && arr.toSet().size() == arr.size()
        && (arr.size() <= 0 || isValidQuizSessionToken(arr[0], bookId))
        && (arr.size() <= 1 || isValidQuizSessionToken(arr[1], bookId))
        && (arr.size() <= 2 || isValidQuizSessionToken(arr[2], bookId))
        && (arr.size() <= 3 || isValidQuizSessionToken(arr[3], bookId))
        && (arr.size() <= 4 || isValidQuizSessionToken(arr[4], bookId))
        && (arr.size() <= 5 || isValidQuizSessionToken(arr[5], bookId))
        && (arr.size() <= 6 || isValidQuizSessionToken(arr[6], bookId))
        && (arr.size() <= 7 || isValidQuizSessionToken(arr[7], bookId))
        && (arr.size() <= 8 || isValidQuizSessionToken(arr[8], bookId))
        && (arr.size() <= 9 || isValidQuizSessionToken(arr[9], bookId))
        && (arr.size() <= 10 || isValidQuizSessionToken(arr[10], bookId))
        && (arr.size() <= 11 || isValidQuizSessionToken(arr[11], bookId))
        && (arr.size() <= 12 || isValidQuizSessionToken(arr[12], bookId))
        && (arr.size() <= 13 || isValidQuizSessionToken(arr[13], bookId))
        && (arr.size() <= 14 || isValidQuizSessionToken(arr[14], bookId));
    }

    // Standalone Validation Blueprint for UserProfile (safe for create, owner update, and superadmin role update)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'avatarUrl', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && isValidDisplayName(data)
        && isValidAvatarUrl(data)
        && isValidOptionalEmail(data)
        && isValidOptionalRole(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Standalone Validation Blueprint for BunpouBookProgress (safe for both create and update)
    function isValidBunpouProgress(data, bookId) {
      return data.keys().hasAll(['uid', 'bookId', 'mastered', 'hard', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'bookId', 'mastered', 'hard', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidBookId(data.bookId)
        && data.bookId == bookId
        && isValidBunpouList(data.mastered, bookId)
        && isValidBunpouList(data.hard, bookId)
        && data.mastered.toSet().intersection(data.hard.toSet()).size() == 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Standalone Validation Blueprint for BunpouQuizHistory (safe for both create and update)
    function isValidBunpouQuizHistory(data, bookId) {
      return data.keys().hasAll(['uid', 'bookId', 'sessions', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'bookId', 'sessions', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidBookId(data.bookId)
        && data.bookId == bookId
        && isValidQuizHistorySessions(data.sessions, bookId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLiveQuizOptions(arr) {
      return arr is list
        && (
          arr.size() == 0
          || (
            arr.size() == 4
            && arr[0] is string && arr[0].size() <= 220
            && arr[1] is string && arr[1].size() <= 220
            && arr[2] is string && arr[2].size() <= 220
            && arr[3] is string && arr[3].size() <= 220
          )
        );
    }

    function isValidOptionalLiveQuizFields(data) {
      return (!('quizLiveType' in data) || (data.quizLiveType is string && data.quizLiveType in ['', 'cloze', 'formula', 'function']))
        && (!('quizLiveChapter' in data) || (data.quizLiveChapter is int && data.quizLiveChapter >= 0 && data.quizLiveChapter <= 18))
        && (!('quizLivePatternTitle' in data) || (data.quizLivePatternTitle is string && data.quizLivePatternTitle.size() <= 120))
        && (!('quizLivePrompt' in data) || (data.quizLivePrompt is string && data.quizLivePrompt.size() <= 320))
        && (!('quizLiveJapanese' in data) || (data.quizLiveJapanese is string && data.quizLiveJapanese.size() <= 400))
        && (!('quizLiveOptions' in data) || isValidLiveQuizOptions(data.quizLiveOptions))
        && (!('quizLiveCorrectIndex' in data) || (data.quizLiveCorrectIndex is int && data.quizLiveCorrectIndex >= -1 && data.quizLiveCorrectIndex <= 3))
        && (!('quizLiveChosenIndex' in data) || (data.quizLiveChosenIndex is int && data.quizLiveChosenIndex >= -1 && data.quizLiveChosenIndex <= 3))
        && (
          !('quizLiveOptions' in data)
          || (
            data.quizLiveOptions.size() == 0
            && (!('quizLiveCorrectIndex' in data) || data.quizLiveCorrectIndex == -1)
            && (!('quizLiveChosenIndex' in data) || data.quizLiveChosenIndex == -1)
          )
          || (
            data.quizLiveOptions.size() == 4
            && ('quizLiveCorrectIndex' in data)
            && data.quizLiveCorrectIndex >= 0
            && data.quizLiveCorrectIndex <= 3
          )
        );
    }

    // Standalone Validation Blueprint for LiveActivity (safe for both create and update)
    function isValidLiveActivity(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'avatarUrl',
          'activeBookId',
          'activeTab',
          'activeChapterLabel',
          'activityType',
          'activitySummary',
          'quizLiveCurrent',
          'quizLiveTotal',
          'quizLiveCorrect',
          'masteredTotal',
          'hardTotal',
          'introMastered',
          'elem1Mastered',
          'elem2Mastered',
          'latestQuizScore',
          'latestQuizSummary',
          'quizSessionCount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'avatarUrl',
          'activeBookId',
          'activeTab',
          'activeChapterLabel',
          'activityType',
          'activitySummary',
          'quizLiveCurrent',
          'quizLiveTotal',
          'quizLiveCorrect',
          'quizLiveType',
          'quizLiveChapter',
          'quizLivePatternTitle',
          'quizLivePrompt',
          'quizLiveJapanese',
          'quizLiveOptions',
          'quizLiveCorrectIndex',
          'quizLiveChosenIndex',
          'masteredTotal',
          'hardTotal',
          'introMastered',
          'elem1Mastered',
          'elem2Mastered',
          'latestQuizScore',
          'latestQuizSummary',
          'quizSessionCount',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() <= 60
        && data.email is string
        && data.email.size() <= 120
        && isCallerBoundEmail(data)
        && isValidAvatarUrl(data)
        && isValidBookId(data.activeBookId)
        && data.activeTab is string
        && data.activeTab in ['card', 'list', 'quiz', 'guide', 'admin']
        && data.activeChapterLabel is string
        && data.activeChapterLabel.size() >= 1
        && data.activeChapterLabel.size() <= 80
        && data.activityType is string
        && data.activityType in ['browsing', 'flashcard', 'list', 'quiz_running', 'quiz_finished', 'guide', 'admin']
        && data.activitySummary is string
        && data.activitySummary.size() >= 1
        && data.activitySummary.size() <= 180
        && data.quizLiveCurrent is int && data.quizLiveCurrent >= 0 && data.quizLiveCurrent <= 300
        && data.quizLiveTotal is int && data.quizLiveTotal >= 0 && data.quizLiveTotal <= 300
        && data.quizLiveCorrect is int && data.quizLiveCorrect >= 0 && data.quizLiveCorrect <= 300
        && data.quizLiveCorrect <= data.quizLiveTotal
        && isValidOptionalLiveQuizFields(data)
        && data.masteredTotal is int && data.masteredTotal >= 0 && data.masteredTotal <= 300
        && data.hardTotal is int && data.hardTotal >= 0 && data.hardTotal <= 300
        && data.introMastered is int && data.introMastered >= 0 && data.introMastered <= 150
        && data.elem1Mastered is int && data.elem1Mastered >= 0 && data.elem1Mastered <= 150
        && data.elem2Mastered is int && data.elem2Mastered >= 0 && data.elem2Mastered <= 150
        && data.latestQuizScore is int && data.latestQuizScore >= -1 && data.latestQuizScore <= 100
        && data.latestQuizSummary is string && data.latestQuizSummary.size() <= 180
        && data.quizSessionCount is int && data.quizSessionCount >= 0 && data.quizSessionCount <= 9999
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Standalone Validation Blueprint for immutable ActivityEvent
    function isValidActivityEvent(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'eventType',
          'bookId',
          'scopeLabel',
          'focus',
          'correct',
          'total',
          'score',
          'summary',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'eventType',
          'bookId',
          'scopeLabel',
          'focus',
          'correct',
          'total',
          'score',
          'summary',
          'createdAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && data.email is string
        && data.email.size() <= 120
        && isCallerBoundEmail(data)
        && data.eventType is string
        && data.eventType in ['quiz_started', 'quiz_completed', 'progress_milestone']
        && isValidBookId(data.bookId)
        && data.scopeLabel is string
        && data.scopeLabel.size() >= 1
        && data.scopeLabel.size() <= 80
        && data.focus is string
        && data.focus in ['mixed', 'cloze', 'formula', 'function', 'none']
        && data.correct is int && data.correct >= 0 && data.correct <= 300
        && data.total is int && data.total >= 0 && data.total <= 300
        && data.correct <= data.total
        && data.score is int && data.score >= -1 && data.score <= 100
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 200
        && data.createdAt is timestamp;
    }

    // --- /users/{userId} ---
    match /users/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && (isOwner(userId) || isAdminOrSuperAdmin());

      allow list: if isSignedIn()
        && isAdminOrSuperAdmin()
        && request.query.limit <= 100;

      allow create: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && isCallerBoundEmail(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isBootstrapSuperAdmin() && (!('role' in incoming()) || incoming().role == 'superadmin'))
          || (!('role' in incoming()) || incoming().role == 'user')
        );

      allow update: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Owner updates own profile fields (cannot change role)
          (
            isOwner(userId)
            && isCallerBoundEmail(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'email', 'updatedAt'])
          )
          ||
          // Action 2: Bootstrap Superadmin self-heals role='superadmin' on legacy profile document
          (
            isOwner(userId)
            && isBootstrapSuperAdmin()
            && isCallerBoundEmail(incoming())
            && ('role' in incoming())
            && incoming().role == 'superadmin'
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'email', 'role', 'updatedAt'])
          )
          ||
          // Action 3: Superadmin grants or revokes 'admin' / 'superadmin' role on another user
          // (cannot modify self or demote the primary bootstrap Superadmin)
          (
            isSuperAdmin()
            && userId != request.auth.uid
            && (!('email' in existing()) || existing().email != 'jrenghaha2@gmail.com')
            && ('role' in incoming())
            && incoming().role in ['user', 'admin', 'superadmin']
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])
          )
        );

      // Deny client-side profile deletion to prevent orphaned subcollections
      allow delete: if false;

      // --- /users/{userId}/bunpouProgress/{bookId} ---
      match /bunpouProgress/{bookId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidBookId(bookId)
          && (isOwner(userId) || isAdminOrSuperAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if false;

        allow create: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && isValidBunpouProgress(incoming(), bookId)
          && incoming().uid == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && isValidBunpouProgress(incoming(), bookId)
          && incoming().uid == existing().uid
          && incoming().bookId == existing().bookId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['mastered', 'hard', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }

      // --- /users/{userId}/quizHistory/{bookId} ---
      match /quizHistory/{bookId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidBookId(bookId)
          && (isOwner(userId) || isAdminOrSuperAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if false;

        allow create: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && isValidBunpouQuizHistory(incoming(), bookId)
          && incoming().uid == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && isValidBunpouQuizHistory(incoming(), bookId)
          && incoming().uid == existing().uid
          && incoming().bookId == existing().bookId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['sessions', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isSignedIn()
          && isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookId(bookId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }

    // --- /liveActivity/{userId} ---
    match /liveActivity/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && (isOwner(userId) || isAdminOrSuperAdmin());

      allow list: if isSignedIn()
        && isAdminOrSuperAdmin()
        && request.query.limit <= 100;

      allow create: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidLiveActivity(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(userId));

      allow update: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidLiveActivity(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'avatarUrl',
          'activeBookId',
          'activeTab',
          'activeChapterLabel',
          'activityType',
          'activitySummary',
          'quizLiveCurrent',
          'quizLiveTotal',
          'quizLiveCorrect',
          'quizLiveType',
          'quizLiveChapter',
          'quizLivePatternTitle',
          'quizLivePrompt',
          'quizLiveJapanese',
          'quizLiveOptions',
          'quizLiveCorrectIndex',
          'quizLiveChosenIndex',
          'masteredTotal',
          'hardTotal',
          'introMastered',
          'elem1Mastered',
          'elem2Mastered',
          'latestQuizScore',
          'latestQuizSummary',
          'quizSessionCount',
          'updatedAt'
        ])
        && exists(/databases/$(database)/documents/users/$(userId));

      allow delete: if false;
    }

    // --- /activityEvents/{eventId} ---
    match /activityEvents/{eventId} {
      allow get: if isSignedIn()
        && isValidId(eventId)
        && isAdminOrSuperAdmin();

      allow list: if isSignedIn()
        && isAdminOrSuperAdmin()
        && request.query.limit <= 100;

      allow create: if isSignedIn()
        && isVerifiedUser()
        && isValidId(eventId)
        && isValidActivityEvent(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update, delete: if false;
    }
  }
}
